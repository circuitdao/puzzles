(mod (ATOM_ANNOUNCER_MOD_HASH
      M_OF_N ; overwrites m_of_n op arg
      WHITELIST ; launcher IDs of whitelisted announcers
      MOD_HASH
      STATUTES_STRUCT
      PRICE_INFOS
      (
        statutes_inner_puzzle_hash
        _ ; m_of_n not needed by backup oracle
        price_updatable_after_seconds_in
        price_updatable_threshold_bps_in
        price_delay_in
        current_timestamp_in
        price_announcers ; -> ((launcher_id args_hash price))
      )
      input_conditions
    )

  (include *standard-cl-23.1*)
  (include curry.clib)
  (include condition_codes.clib)
  (include statutes_utils.clib)
  (include utils.clib)
  (include oracle.clib)
  (defconst MAX_ORACLE_PRICE (* 1000000 PRICE_PRECISION))


  (defun generate-whitelisted-announcer-conditions (
      WHITELIST
      STATUTES_STRUCT
      ATOM_ANNOUNCER_MOD_HASH
      ( (launcher_id args_hash price) . rest_price_announcers)
      list_to_append_to
    )
    (assert
      ; verify types
      (is-size-b32 launcher_id)
      (is-size-b32 args_hash)
      (contains WHITELIST launcher_id)
      ; we don't need to verify that announcer is not expired since it's already checked in announcer puzzle
      (c
        (list ASSERT_PUZZLE_ANNOUNCEMENT
          (sha256
            (tree_hash_of_apply ATOM_ANNOUNCER_MOD_HASH args_hash)
            PROTOCOL_PREFIX
            (sha256tree
              (c STATUTES_STRUCT (c launcher_id (c ONE (to-uint80 price)))) ; ONE indicates that announcer is approved
            )
          )
        )
        (if rest_price_announcers
          (generate-whitelisted-announcer-conditions
            WHITELIST
            STATUTES_STRUCT
            ATOM_ANNOUNCER_MOD_HASH
            rest_price_announcers
            list_to_append_to
          )
          list_to_append_to
        )
      )
    )
  )


  (assign
    price_updatable_after_seconds (to-uint80 price_updatable_after_seconds_in)
    price_updatable_threshold_bps (to-uint80 price_updatable_threshold_bps_in)
    price_delay (to-uint80 price_delay_in)
    current_timestamp (to-uint80 current_timestamp_in)
    statutes_puzzle_hash (calculate-statutes-puzzle-hash STATUTES_STRUCT statutes_inner_puzzle_hash)
    ; number of announcers being used in oracle price update
    price_announcers_length (list-length price_announcers 0)
    ; extract and sort announcer prices in ascending order
    sorted_prices (mergesort price_announcers) ; TODO: convert prices to uint80 before sorting
    ; get (upper) median price
    median_price (f (r (r (get-price sorted_prices (get-median-index price_announcers_length) 0))))
    conditions (generate-whitelisted-announcer-conditions
      WHITELIST
      STATUTES_STRUCT
      ATOM_ANNOUNCER_MOD_HASH
      price_announcers
      input_conditions
    )
    ; discard matured price infos other than most recent one, if any
    ; the Oracle Price is by definition the most recent matured price
    (last_matured_price_info . cut_price_infos) (cut-price-infos PRICE_INFOS (- current_timestamp price_delay) ())
    ; append new price info to the end of the buffer (FIFO)
    new_price_infos (merge-lists
        cut_price_infos
        (list (c median_price current_timestamp))
    )
    (last_matured_price . last_matured_price_updated) (if last_matured_price_info last_matured_price_info (c () ()))
    ; most recent price info in existing buffer, i.e. excluding new price info being appended
    (last_price . last_price_updated) (last-item cut_price_infos) ; TODO: use cut_price_infos instead of PRICE_INFOS for efficiency?
    (assert_debug
      (> median_price MINUS_ONE) (> MAX_ORACLE_PRICE median_price)
      ; verify types
      (is-size-b32 statutes_inner_puzzle_hash)
      ; oracle price update requires at least M-of-N announcers
      (> price_announcers_length (- M_OF_N ONE))
      ; check that no announcer is being used more than once
      (unique price_announcers)
      ; oracle price must be greater than 0
      ; this is required for get-min-collateral-amount function, which divides by price
      (> median_price 0)
      ; price info timestamps must increase strictly
      (> current_timestamp last_price_updated)
      ; oracle price update only allowed if enough time has passed or price change sufficiently large
      (any
        (> (- current_timestamp last_price_updated) price_updatable_after_seconds)
        (> (abs (/ (* (- last_price median_price) PRECISION_BPS) last_price) ) price_updatable_threshold_bps)
      )
      (li
        ; ensure current timestamp is in range last_block > current_timestamp - 1 block < next block
        (list ASSERT_BEFORE_SECONDS_ABSOLUTE (+ current_timestamp MAX_TX_BLOCK_TIME ))
        (list ASSERT_SECONDS_ABSOLUTE (- current_timestamp MAX_TX_BLOCK_TIME))
        (assert-statute statutes_puzzle_hash STATUTE_ORACLE_PRICE_UPDATE_DELAY price_updatable_after_seconds)
        (assert-statute statutes_puzzle_hash STATUTE_ORACLE_PRICE_UPDATE_RATIO_BPS price_updatable_threshold_bps)
        (assert-statute statutes_puzzle_hash STATUTE_PRICE_DELAY price_delay)
        (if (r PRICE_INFOS)
          (list ASSERT_HEIGHT_RELATIVE 0)
          (list REMARK)
        )
        (if last_matured_price
          (list CREATE_PUZZLE_ANNOUNCEMENT
            (sha256tree (c last_matured_price (c last_matured_price_updated price_delay)))
          )
          (list REMARK)
        )
        (list
          CREATE_COIN
          (curry_hashes MOD_HASH
            (sha256 ONE MOD_HASH)
            (sha256tree STATUTES_STRUCT)
            (sha256tree new_price_infos)
          )
          ; min singleton amount, force it to be ONE
          ONE
        )
        (list REMARK new_price_infos last_matured_price)
        &rest
        conditions
      )
    )
  )
)

; register the announcer with announcer registry coin
(mod ((MOD_HASH STATUTES_STRUCT LAUNCHER_ID PREV_ANNOUNCE INNER_PUZZLE_HASH APPROVED DEPOSIT
        VALUE_TTL VALUE MIN_DEPOSIT CLAIM_COUNTER COOLDOWN_START PENALIZABLE_AT TIMESTAMP_EXPIRES
      )
      ; solution
      inner_puzzle_hash ; verified in main puzzle
      new_puzzle_hash ; verify
      deposit_in ; to int
      input_conditions ; don't verify
      (
        registry_mod_hash ; verify
        registry_args_hash ; verify
        registry_claim_counter_in ; to int
        target_puzzle_hash ; verify
        statutes_inner_puzzle_hash ; verify
        min_deposit ; statute
      )
    )

  (include *standard-cl-23.1*)
  (include condition_codes.clib)
  (include curry.clib)
  (include utils.clib)
  (include statutes_utils.clib)
  (include announcer.clib)

  (assign
    ; validate and convert types
    deposit (to-uint64 deposit_in)
    registry_claim_counter (to-uint64 registry_claim_counter_in)
    announcer_registry_puzhash (tree_hash_of_apply registry_mod_hash registry_args_hash)
    statutes_puzzle_hash (calculate-statutes-puzzle-hash STATUTES_STRUCT statutes_inner_puzzle_hash)
    (assert
      inner_puzzle_hash ; must be owner
      (not new_puzzle_hash)
      (is-size-b32 registry_mod_hash)
      (is-size-b32 registry_args_hash)
      (is-size-b32 target_puzzle_hash)
      (is-size-b32 statutes_inner_puzzle_hash)
      APPROVED
      (> registry_claim_counter CLAIM_COUNTER)
      (> deposit (- MIN_DEPOSIT ONE)) ; must not be penalizable for deposit
      (> MIN_DEPOSIT (- min_deposit ONE)) ; must not be penalizable for min deposit
      (c
        (list SEND_MESSAGE 0x12
          (concat
            PROTOCOL_PREFIX
            (sha256tree
              (c inner_puzzle_hash
                (c STATUTES_STRUCT
                  (c target_puzzle_hash
                    (c APPROVED
                       registry_claim_counter
                    )
                  )
                )
              )
            )
          )
          announcer_registry_puzhash
        )
        ; must not be expired
        (c
          (list ASSERT_BEFORE_SECONDS_ABSOLUTE TIMESTAMP_EXPIRES)
          (c
            (assert-statute statutes_puzzle_hash STATUTE_ANNOUNCER_MINIMUM_DEPOSIT_MOJOS min_deposit)
            (recreate-myself-condition MOD_HASH
              STATUTES_STRUCT
              LAUNCHER_ID
              FALSE
              INNER_PUZZLE_HASH
              APPROVED
              DEPOSIT
              deposit
              VALUE_TTL
              VALUE
              MIN_DEPOSIT
              registry_claim_counter
              COOLDOWN_START
              PENALIZABLE_AT
              TIMESTAMP_EXPIRES
              input_conditions
            )
          )
        )
      )
    )
  )
)

; governance
; we either activate this announcer or deactivate, can happen at any time via CRT vote
(mod ((MOD_HASH STATUTES_STRUCT LAUNCHER_ID PREV_ANNOUNCE INNER_PUZZLE_HASH APPROVED DEPOSIT
       VALUE_TTL VALUE MIN_DEPOSIT CLAIM_COUNTER COOLDOWN_START PENALIZABLE_AT TIMESTAMP_EXPIRES
      )
      ; solution
      inner_puzzle_hash new_puzzle_hash deposit input_conditions
      (
        statutes_inner_puzzle_hash
        input_toggle_activation
        max_disapproval_penalty_factor_or_min_deposit ; penalty factor when disapproving, min deposit when approving
      )
    )

  (include *standard-cl-23.1*)
  (include condition_codes.clib)
  (include curry.clib)
  (include utils.clib)
  (include statutes_utils.clib)
  (include announcer.clib)


  (assign
    ; validate and convert types
    validated_deposit (to-uint64 deposit)
    validated_max_penalty_or_min (to-uint64 max_disapproval_penalty_factor_or_min_deposit)
    ; input_toggle_activation is boolean (0/1), keep as is-atom check below
  (assert
    (not new_puzzle_hash)
    (is-size-b32 statutes_inner_puzzle_hash)
    (not (l input_toggle_activation)) ; is-atom check for boolean
    (assign
      toggle_activation (assert
        (any
          (all (= input_toggle_activation FALSE) APPROVED)
          (all (= input_toggle_activation TRUE) (not APPROVED))
        )
        input_toggle_activation
      )
      statutes_puzzle_hash (calculate-statutes-puzzle-hash STATUTES_STRUCT statutes_inner_puzzle_hash)
      operation_conditions (recreate-myself-condition MOD_HASH
        STATUTES_STRUCT
        LAUNCHER_ID
        FALSE
        INNER_PUZZLE_HASH
        toggle_activation
        DEPOSIT
        validated_deposit
        VALUE_TTL
        VALUE
        MIN_DEPOSIT
        CLAIM_COUNTER
        COOLDOWN_START
        PENALIZABLE_AT
        TIMESTAMP_EXPIRES
        (if (= toggle_activation FALSE)
          ; we're disapproving. use deposit for fees
          (assign
            min_penalized_deposit (- DEPOSIT (/ (/ (* DEPOSIT PRECISION validated_max_penalty_or_min) PRECISION) PRECISION_BPS))
            (assert
              ; can't deduct more for fees than penalty
              (all (> (+ DEPOSIT ONE) validated_deposit) (> validated_deposit (- min_penalized_deposit ONE)))
              (c
                (list RESERVE_FEE (- DEPOSIT validated_deposit))
                (c
                  (assert-statute statutes_puzzle_hash STATUTE_ANNOUNCER_DISAPPROVAL_MAXIMUM_PENALTY_BPS validated_max_penalty_or_min)
                  input_conditions
                )
              )
            )
          )
          ; we're approving
          (assert
            ; we're not requiring that VALUE_TTL <= Statutes max value TTL or that price is not expired in case an announcer has a
            ;  technical issue just when governance wants to implement approval bill. but we always want DEPOSIT and MIN_DEPOSIT
            ;  to be set properly so that announcer can be penalized
            (= validated_deposit DEPOSIT) ; can't steal deposit
            ; deposit must be no less than both announcer and statutes min deposit
            (> validated_deposit (- MIN_DEPOSIT ONE))
            (> MIN_DEPOSIT (- validated_max_penalty_or_min ONE))
            (c
              (assert-statute statutes_puzzle_hash STATUTE_ANNOUNCER_MINIMUM_DEPOSIT_MOJOS validated_max_penalty_or_min)
              input_conditions
            )
          )
        )
      )
      (li
        (list ASSERT_PUZZLE_ANNOUNCEMENT
          (sha256
            statutes_puzzle_hash
            PROTOCOL_PREFIX
            CUSTOM_CONDITION_PREFIX
            (sha256tree (c LAUNCHER_ID toggle_activation))
          )
        )
        &rest
        operation_conditions
      )
    )
  ))
)

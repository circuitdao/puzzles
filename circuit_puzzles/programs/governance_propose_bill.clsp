(mod (
    (BILL MOD_HASH INNER_PUZZLE_HASH CAT_MOD_HASH CRT_TAIL_HASH STATUTES_STRUCT
     statutes_puzzle_hash)
    (
      amount ; is uint
      bill_proposal_fee_mojos ; is uint
      (@ new_bill (
        statute_index ; is int
        new_statute_value ; don't verify
        new_threshold_amount_to_propose ; is uint
        new_veto_interval ; is uint
        new_implementation_delay ; is uint
        new_max_delta ; is uint
      ))
      (@ current_statute (
        statute_value
        threshold_amount_to_propose
        veto_interval
        implementation_delay
        max_delta
      ))
      current_timestamp ; is uint
      implementation_interval ; is uint
    )
  )

  (include *standard-cl-23.1*)
  (include condition_codes.clib)
  (include statutes_utils.clib)
  (include utils.clib)

  (defconst ANN_PROPOSED '^')
  (defconst INTERVAL_LOWER_HARD_LIMIT 1800) ; 30 mins in seconds
  (defconst INTERVAL_UPPER_HARD_LIMIT 604800) ; 7 days in seconds
  (defconst MAINTAINER_MIN_VOTE_AMOUNT 350000000000)  ; min 350BN mCRT in a single vote to enable override

  (defun-inline validate-statute-value (statute_index new_statute_value)
    (if (= statute_index STATUTE_GOVERNANCE_IMPLEMENTATION_INTERVAL)
      (> new_statute_value INTERVAL_LOWER_HARD_LIMIT)
      (if (any
            (= statute_index STATUTE_STABILITY_FEE_DF)
            (= statute_index STATUTE_INTEREST_DF)
          )
        ; must be at least PRECISION for non-negative rates
        (> new_statute_value (- PRECISION ONE))
        (if (= statute_index STATUTE_TREASURY_MAXIMUM) ; NEW / TODO: keep this exception? don't need to if default is to allow negative statute values (see below)
          (> new_statute_value (- MINUS_ONE ONE)) ; must be no less than -1 ; NEW
          (if (any
                (= statute_index STATUTE_ORACLE_M_OF_N)
                (= statute_index STATUTE_VAULT_LIQUIDATION_RATIO_PCT)
                (= statute_index STATUTE_VAULT_AUCTION_STARTING_PRICE_FACTOR_BPS)
                (= statute_index STATUTE_VAULT_AUCTION_PRICE_TTL)
                (= statute_index STATUTE_VAULT_AUCTION_MINIMUM_PRICE_FACTOR_BPS)
              )
            (> new_statute_value 0) ; must be strictly larger than 0
            (> new_statute_value -1) ; ONE ; allow 0 for other statutes ; NEW / TODO: allow negative values or not?
          )
        )
      )
    )
  )

  (assert
    (is-uint64 amount)
    (is-uint64 bill_proposal_fee_mojos)
    (is-int64 statute_index) ; can be -1 for custom conditions
    (is-uint64 new_threshold_amount_to_propose)
    (is-uint64 new_veto_interval)
    (is-uint64 new_implementation_delay)
    (is-uint64 new_max_delta)
    (is-uint64 current_timestamp)
    (is-uint64 implementation_interval)
    (if (= statute_index MINUS_ONE)
      ; custom conditions: must be a list
      (l new_statute_value)
      (if (= statute_index STATUTE_ORACLE_LAUNCHER_ID)
        ; oracle launcher id: must be 32 bytes
        (is-size-b32 new_statute_value)
        ; standard statutes (index > 0)
        (all
          (is-atom new_statute_value)
          (= (+ new_statute_value) new_statute_value) ; must be in canonical representation
          (validate-statute-value
            statute_index
            new_statute_value
          )
        )
      )
    )
    (> INTERVAL_UPPER_HARD_LIMIT (- new_veto_interval ONE))
    (> (+ new_veto_interval ONE) INTERVAL_LOWER_HARD_LIMIT)
    (> INTERVAL_UPPER_HARD_LIMIT (- new_implementation_delay ONE))
    ; may not overwrite an existing bill
    (not BILL)
    (> amount threshold_amount_to_propose)
    (all (> new_threshold_amount_to_propose 0) (> MAINTAINER_MIN_VOTE_AMOUNT new_threshold_amount_to_propose))
    (> new_veto_interval 0)
    (> new_implementation_delay 0)
    ; if max_delta is set and applicable to statute, we enforce it
    (if (any (= max_delta 0) (> ONE statute_index))
      ONE  ; max_delta=0 disables the delta check entirely
      ; or new value must be within max_delta of current value
      (if (> new_statute_value statute_value)
        (> max_delta (- new_statute_value statute_value))
        (> max_delta (- statute_value new_statute_value))
      )
    )
    (list
      (c
        ; set proposal times
        (c (+ current_timestamp veto_interval) ; veto_interval_expiry
          (c (+ current_timestamp veto_interval implementation_delay) ; implementation_delay_expiry
            (+ current_timestamp veto_interval implementation_delay implementation_interval) ; implementation_interval_expiry
          )
        )
        new_bill
      )
      (list
        ; to avoid the network being spammed with proposals, we require a fee to be paid
        (list RESERVE_FEE bill_proposal_fee_mojos)
        (list CREATE_COIN_ANNOUNCEMENT (concat PROTOCOL_PREFIX (sha256tree ANN_PROPOSED)))
        ; assert that passed statute index corresponds to correct statute
        ; and that passed statute values are correct
        (assert-full-statute
          statutes_puzzle_hash
          ; we use special statute for custom conditions limits
          (if (= statute_index MINUS_ONE) STATUTE_CUSTOM_CONDITIONS statute_index)
          current_statute
        )
        (list ASSERT_SECONDS_ABSOLUTE (- current_timestamp MAX_TX_BLOCK_TIME))
        (list ASSERT_BEFORE_SECONDS_ABSOLUTE (+ current_timestamp (* 5 MAX_TX_BLOCK_TIME)))
        (assert-statute statutes_puzzle_hash STATUTE_GOVERNANCE_BILL_PROPOSAL_FEE_MOJOS bill_proposal_fee_mojos)
        (assert-statute statutes_puzzle_hash STATUTE_GOVERNANCE_IMPLEMENTATION_INTERVAL implementation_interval)
      )
    )
  )
)

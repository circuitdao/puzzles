(mod
  (
    CAT_MOD_HASH BYC_TAIL_MOD_HASH RUN_TAIL_MOD_HASH TREASURY_MOD_HASH
    (@ VAULT_STATE
      (
       COLLATERAL
       PRINCIPAL AUCTION_STATE INNER_PUZZLE_HASH
       STATUTES_STRUCT DISCOUNTED_PRINCIPAL
       statutes_puzzle_hash ; verified in main puzzle
       inner_puzzle_hash ; verified in main puzzle
      )
    )
    (@ args
      (
        byc_issuing_coin_parent_id ; verify
        statutes_cumulative_stability_fee_df ; statute
        byc_treasury_coin_info ; see below
        min_treasury_delta ; statute
        current_timestamp_in ; to int
        current_stability_fee_df ; statute
        price_info ; statute
        liquidation_ratio ; statute
      )
    )
  )

  (include *standard-cl-23.1*)
  (include utils.clib)
  (include vault.clib)
  (include statutes_utils.clib)
  (include condition_codes.clib)
  (include curry.clib)

  (assign
    current_timestamp (to-int80 current_timestamp_in)
    byc_tail_hash (curry_hashes BYC_TAIL_MOD_HASH (sha256tree STATUTES_STRUCT))
    cumulative_stability_fee_df (calculate-cumulative-discount-factor
      statutes_cumulative_stability_fee_df
      current_stability_fee_df
      current_timestamp
      (r price_info)
    )
    undiscounted_principal (undiscount-principal DISCOUNTED_PRINCIPAL cumulative_stability_fee_df)
    min_collateral_amount (get-min-collateral-amount
      undiscounted_principal
      liquidation_ratio
      (f price_info)
    )
    fees_to_treasury (calculate-total-fees undiscounted_principal PRINCIPAL 0)
    (treasury_parent_id treasury_launcher_id treasury_prev_launcher_id treasury_amount_in) byc_treasury_coin_info
    treasury_amount (to-uint80 treasury_amount_in)
    new_treasury_amount (+ fees_to_treasury treasury_amount)
    byc_issuing_coin_id (assert
      (is-size-b32 byc_issuing_coin_parent_id)
      (calculate-byc-coin-id
        CAT_MOD_HASH
        byc_tail_hash
        (list
          byc_issuing_coin_parent_id
          fees_to_treasury
          RUN_TAIL_MOD_HASH
        )
      )
    )
    treasury_coin_id (calculate-byc-coin-id
      CAT_MOD_HASH
      byc_tail_hash
      (list
        treasury_parent_id
        treasury_amount
        (curry_hashes
          TREASURY_MOD_HASH
          (sha256 ONE TREASURY_MOD_HASH)
          (sha256tree STATUTES_STRUCT)
          (sha256 ONE treasury_launcher_id)
          (sha256 ONE treasury_prev_launcher_id)
        )
      )
    )
    (assert
      (is-size-b32 treasury_parent_id)
      (is-size-b32 treasury_launcher_id)
      (is-size-b32 treasury_prev_launcher_id)
      ; only if there are fees to transfer
      (> fees_to_treasury 0)
      ; to avoid keepers dusting and hogging treasury coins
      (> fees_to_treasury min_treasury_delta)
      ; only if vault is not in liquidation or bad debt
      (not AUCTION_STATE)
      ; vault must not be liquidatable
      (> COLLATERAL (- min_collateral_amount ONE))
      (list
        (list
          COLLATERAL
          (+ PRINCIPAL fees_to_treasury)
          AUCTION_STATE
          INNER_PUZZLE_HASH
          DISCOUNTED_PRINCIPAL
        )
        (list
          ; signal to tail that it can issue BYC with certain amount
          (list SEND_MESSAGE 0x3f
            (concat PROTOCOL_PREFIX (sha256tree (c inner_puzzle_hash (c STATUTES_STRUCT (c "i" fees_to_treasury)))))
            byc_issuing_coin_id
          )
          ; approve treasury coin to receive a deposit
          (list SEND_MESSAGE 0x3f
            (concat
              PROTOCOL_PREFIX
              (sha256tree (c inner_puzzle_hash (c STATUTES_STRUCT (c fees_to_treasury new_treasury_amount))))
            )
            treasury_coin_id
          )
          (assert-statute statutes_puzzle_hash STATUTE_CUMULATIVE_STABILITY_FEE_DF statutes_cumulative_stability_fee_df)
          (assert-statute statutes_puzzle_hash STATUTE_TREASURY_MINIMUM_DELTA min_treasury_delta)
          (assert-price-info statutes_puzzle_hash price_info)
          (list ASSERT_SECONDS_ABSOLUTE (- current_timestamp MAX_TX_BLOCK_TIME))
          (list ASSERT_BEFORE_SECONDS_ABSOLUTE (+ current_timestamp MAX_TX_BLOCK_TIME))
          (assert-statute statutes_puzzle_hash STATUTE_STABILITY_FEE_DF current_stability_fee_df)
          (assert-statute statutes_puzzle_hash STATUTE_VAULT_LIQUIDATION_RATIO_PCT liquidation_ratio)
          (assert-statute statutes_puzzle_hash STATUTE_BLOCK_ISSUANCE FALSE)
        )
      )
    )
  )
)

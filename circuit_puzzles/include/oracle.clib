(

  (include prefixes.clib)

  (defun cut-price-infos (price_info_list cutoff last_matured_price_info)
    ;; this function should be called with last_matured_price_info = nil.
    ;;
    ;; returns return_value = (last_matured_price_info (c last_matured_price_info non_matured_price_infos))
    ;; if there is a matured price_info, or (() non_matured_price_infos) otherwise, where
    ;; last_matured_price_info is the matured price_info with greatest (i.e. most recent) timestamp
    ;; and non_matured_price_infos is the list of non-matured price_infos.
    ;;
    ;; if price_info_list is empty (and this is the initial call with last_matured_price_info = nil),
    ;; then (() ()) is returned.
    ;; if price_info_list was non-empty and all entries are matured, then
    ;; (last_matured_price_info (list last_matured_price_info)) is returned.
    ;; if price_info_list is non-empty, then (r return_value) is not nil, i.e. cutting a
    ;; a non-empty price_info_list will leave at least one (matured or non-matured) price_info
    ;; in the list.
    (if price_info_list
      (if (> cutoff  (r (f price_info_list)))
        (cut-price-infos (r price_info_list) cutoff (f price_info_list))
        (c last_matured_price_info
          (if last_matured_price_info
            (c last_matured_price_info price_info_list)
            price_info_list
          )
        )
      )
      (if last_matured_price_info
        ; non-empty input with all entries matured
        (c last_matured_price_info (list last_matured_price_info))
        ; empty input
        (c () ())
      )
    )
  )

  ; true if remark condition body is a valid solution remark (has SOLUTION_PREFIX)
  ; implicitly non-protocol since SOLUTION_PREFIX != PROTOCOL_PREFIX
  (defun-inline is-valid-rmk-solution (condition_body)
    (and
      (l condition_body)
      (not (l (f condition_body)))
      (= (f condition_body) SOLUTION_PREFIX)
    )
  )

  ;; Filters inner puzzle conditions and extracts the solution from a REMARK condition.
  ;;
  ;; This function explicitly blocks CREATE_PUZZLE_ANNOUNCEMENT from inner puzzles
  ;; to prevent fake price announcement injection attacks. Without this, an attacker could
  ;; emit a 32-byte sha256tree hash matching the oracle's price announcement format, which
  ;; would be appended to the oracle's output via &rest inner_conditions.
  ;;
  ;; Fails if:
  ;; - CREATE_COIN condition encountered (inner puzzle cannot create coins)
  ;; - CREATE_PUZZLE_ANNOUNCEMENT condition encountered (prevents price spoofing)
  ;; - Protocol REMARK/MESSAGE condition encountered (is-valid-rmk-cond / is-valid-msg-cond)
  ;; - No solution REMARK condition found
  ;; - More than one solution REMARK encountered (ambiguity / injection)
  ;;
  ;; Solution REMARK format: (REMARK SOLUTION_PREFIX solution_data)
  ;; Returns: (solution_data filtered_conditions)
  (defun filter-and-extract-remark-solution-without-puz-announcements (
        (@ conditions ((condition_code . condition_body) . rest_of_conditions))
        found_solution
        filtered_conditions
      )
    (if conditions
      (if (= condition_code CREATE_COIN)
        (x) ; no create coin condition allowed
        (if (= condition_code REMARK)
          (assert
            (is-valid-rmk-solution condition_body) ; must not be a protocol remark
            (not found_solution) ; only one solution remark allowed
            ; found solution remark
            (filter-and-extract-remark-solution-without-puz-announcements rest_of_conditions (f (r condition_body)) filtered_conditions)
          )
          (if (any (= condition_code SEND_MESSAGE) (= condition_code RECEIVE_MESSAGE))
            (assert
              (is-valid-msg-cond condition_body)
              (filter-and-extract-remark-solution-without-puz-announcements rest_of_conditions found_solution (c (f conditions) filtered_conditions))
            )
            (if (= condition_code CREATE_PUZZLE_ANNOUNCEMENT)
              (x) ; block to prevent fake puzzle announcement injection
              (if (= condition_code CREATE_COIN_ANNOUNCEMENT)
                (assert (is-valid-ann-cond condition_body)
                  (filter-and-extract-remark-solution-without-puz-announcements rest_of_conditions found_solution (c (f conditions) filtered_conditions))
                )
                ; all other conditions allowed
                (filter-and-extract-remark-solution-without-puz-announcements rest_of_conditions found_solution (c (f conditions) filtered_conditions))
              )
            )
          )
        )
      )
      (assert
        found_solution ; must have found a solution
        (list found_solution filtered_conditions)
      )
    )
  )


  (defun-inline abs (number)
    (if (> number MINUS_ONE) number (* number MINUS_ONE))
  )

  (defun last-item (lst)
    (if lst
      (if (r lst)
        (last-item (r lst))
        (f lst)
      )
      (x)
    )
  )

  (defun generate-announcer-conditions (
      STATUTES_STRUCT
      ATOM_ANNOUNCER_MOD_HASH
      ( (launcher_id args_hash price) . rest_price_announcers)
      list_to_append_to
    )
    ; we don't need to verify that announcer is not expired since it's already checked in announcer puzzle
    (if (not (all (= (strlen launcher_id) 32) (= (strlen args_hash) 32)))
      (x) ; verify types
      (c
        (list ASSERT_PUZZLE_ANNOUNCEMENT
          (sha256
            (tree_hash_of_apply ATOM_ANNOUNCER_MOD_HASH args_hash)
            PROTOCOL_PREFIX
            (sha256tree
              (c STATUTES_STRUCT (c launcher_id (c ONE price))) ; ONE indicates that announcer is approved
            )
          )
        )
        (if rest_price_announcers
          (generate-announcer-conditions
            STATUTES_STRUCT
            ATOM_ANNOUNCER_MOD_HASH
            rest_price_announcers
            list_to_append_to
          )
          list_to_append_to
        )
      )
    )
  )

  (defun announcer-list-length (lst count)
    (if lst
      ; force announcer price to be given as integer in canoncial represenation
      (if (not (= (+ (f (r (r (f lst)))) 0) (f (r (r (f lst))))))
        (x)
        (announcer-list-length (r lst) (+ count 1))
      )
      count
    )
  )

  (defun not-contains (lst item)
    (if lst
      (if (= (f (f lst)) item)
        (x)
        (not-contains (r lst) item)
      )
      1
    )
  )

  (defun unique (lst)
    (if (r lst)
      (if (not-contains (r lst) (f (f lst)))
        (unique (r lst))
        (x)
      )
      ONE
    )
  )

  (defun _reverse (L R)
    (if L
      (_reverse
        (r L)
        (c (f L) R)
      )
      R
    )
  )

  (defun-inline endp (L)
    (if L
      (if (r L)
        0
        ONE
      )
      ONE
    )
  )

  (defun _split (Z L R)
    (if (endp R)
        (c (_reverse L ()) Z)
        (_split (r Z) (c (f Z) L) (r (r R))))
    )

  (defun _merge ((@ L ((_ _ L_price) . L_rest)) (@ R ((_ _ R_price) . R_rest)) A)
    (if (any L R)
      (if L
        (if R
          (if (> R_price L_price)
            (_merge L_rest R (c (f L) A))
            (_merge L R_rest (c (f R) A))
          )
          (_merge L_rest () (c (f L) A))
        )
        (_merge () R_rest (c (f R) A))
      )
      (_reverse A ())
    )
  )

  ; thanks @geoff for the mergesort implementation on https://aggsig.me/mergesort.html
  ; takes a list of 3-element lists and returns a list of all 3rd elements in ascending order
  ; by virtue of how _merge function was modified vs original linked above.
  (defun mergesort (Z)
    (if Z
      (if (r Z)
        (assign
          (L . R) (_split Z () Z)
          (_merge (mergesort L) (mergesort R) ())
        )
        Z
      )
      ()
    )
  )

  (defun-inline get-median-index (length)
    ; if odd, we return the middle index. E.g. list length = 3 -> indices = [0 1 2] -> index = 1
    ; if even, we return the larger of the two middle indices: list length = 4 -> indices = [0, 1, 2, 3] -> index = 2
    (/ length TWO)
  )

  (defun get-price (prices index curr_index)
    (if prices
      (if (= index curr_index)
        (f prices)
        (get-price (r prices) index (+ curr_index ONE))
      )
      (x)
    )
  )
)
